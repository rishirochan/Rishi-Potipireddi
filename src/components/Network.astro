---
import Neuron from './Neuron.astro';
import LossCurve from './LossCurve.astro';
import { person, experience, projects, output, weights, BASE_WEIGHT, outWeights } from '../data/profile';

const layers = [
  { name: 'input', count: 1 },
  { name: 'experience', count: experience.length },
  { name: 'projects', count: projects.length },
  { name: 'output', count: output.choices.length },
];

// Edge weights keyed "src>dst". Input fans out evenly; the rest come from profile.ts.
const w: Record<string, number> = {};
for (const e of experience) {
  w[`me>${e.id}`] = 1;
  for (const p of projects) w[`${e.id}>${p.id}`] = weights[e.id]?.[p.id] ?? BASE_WEIGHT;
}
for (const p of projects)
  for (const c of output.choices) w[`${p.id}>${c.id}`] = outWeights[p.id]?.[c.id] ?? BASE_WEIGHT;

const links = output.links.filter((l) => l.href);

// Minimap: the same 1 → n → m → 1 shape, one column per layer.
const MM = { w: 72, h: 30, colGap: 22 };
const mmCols = layers.map((l, i) =>
  Array.from({ length: l.count }, (_, k) => ({
    x: 3 + i * MM.colGap,
    y: MM.h / 2 + (k - (l.count - 1) / 2) * 4.4,
  })),
);
---

<div data-track class="track relative" style={`--layers: ${layers.length}`}>
  {layers.map((_, i) => <div class="snap" style={`top: calc(${i} * var(--seg))`} aria-hidden="true" />)}

  <div data-stage class="stage sticky top-0 h-svh overflow-hidden" data-weights={JSON.stringify(w)} style="--cam: 0">
    <canvas data-edges class="pointer-events-none absolute inset-0" aria-hidden="true"></canvas>

    <header class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-6 pt-6 md:px-10">
      <span class="label text-paper!">rp</span>
      <p class="label hidden sm:block">
        layer <span data-layer-index>0</span><span class="mx-2 text-signal-hi">·</span><span data-layer-name>input</span>
      </p>
      <nav aria-label="Layers" class="relative">
        <svg width={MM.w} height={MM.h} viewBox={`0 0 ${MM.w} ${MM.h}`} class="block overflow-visible" aria-hidden="true">
          {
            mmCols.slice(0, -1).map((col, i) =>
              col.flatMap((a) =>
                mmCols[i + 1].map((b) => (
                  <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="#fafafa" stroke-opacity="0.12" stroke-width="0.5" />
                )),
              ),
            )
          }
          {
            mmCols.map((col, i) => (
              <g data-mm={i} class="mm">
                {col.map((p) => (
                  <circle cx={p.x} cy={p.y} r="1.7" />
                ))}
              </g>
            ))
          }
        </svg>
        <div class="absolute inset-y-0 -left-2 flex">
          {
            layers.map((l, i) => (
              <button type="button" data-jump={i} class="h-full w-[22px] cursor-pointer" aria-label={`Go to ${l.name}`} />
            ))
          }
        </div>
      </nav>
    </header>

    <div data-world class="world absolute inset-0">
      <section class="layer layer-in" style="--i: 0" aria-label="About">
        <Neuron id="me" layer={0} first>
          <h1 slot="title" class="text-4xl leading-none font-light tracking-tight md:text-6xl">{person.name}</h1>
          <p class="font-mono text-xs text-paper/50">
            {person.school} <span class="text-signal-hi">·</span>
            {person.grad}
          </p>
        </Neuron>
      </section>

      <section class="layer" style="--i: 1" aria-label="Experience">
        {
          experience.map((e) => (
            <Neuron id={e.id} layer={1}>
              <h2 slot="title" class="truncate text-xl leading-tight">
                {e.org}
              </h2>
              <p class="font-mono text-[11px] text-paper/45">
                {e.role} <span class="text-signal-hi">·</span> {e.when}
              </p>
              <p class="mt-1 text-sm leading-snug text-paper/65">{e.line}</p>
            </Neuron>
          ))
        }
      </section>

      <section class="layer" style="--i: 2" aria-label="Projects">
        {
          projects.map((p) => (
            <Neuron id={p.id} layer={2}>
              <h2 slot="title" class="truncate text-base leading-tight">
                {p.href ? (
                  <a href={p.href} class="hover:text-signal-hi" target="_blank" rel="noopener">
                    {p.title} <span class="text-xs text-signal-hi">↗</span>
                  </a>
                ) : (
                  p.title
                )}
              </h2>
              <p class="text-[13px] leading-snug text-paper/60">{p.line}</p>
            </Neuron>
          ))
        }
      </section>

      <section class="layer layer-out" style="--i: 3" aria-label="More about me">
        <header>
          <h2 class="text-4xl leading-none font-light tracking-tight md:text-5xl">{person.name}</h2>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm">
            {
              links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener me" class="text-paper/80 hover:text-paper">
                  {l.label} <span class="text-signal-hi">↗</span>
                </a>
              ))
            }
            <span class="break-all text-paper/80 select-all">{output.email}</span>
          </div>
        </header>
        <div data-choices class="choices flex flex-col pt-6">
          {
            output.choices.map((c) => (
              <Neuron id={c.id} layer={3} last class="choice">
                <h3 slot="title" class="text-lg leading-tight">
                  {c.label}
                </h3>
                <span slot="end" data-p class="w-8 flex-none text-right font-mono text-[11px] text-paper/45 tabular-nums">
                  {(1 / output.choices.length).toFixed(2)}
                </span>
                <p class="text-[13px] leading-snug text-paper/65">{c.text}</p>
              </Neuron>
            ))
          }
        </div>
        <LossCurve />
      </section>
    </div>

  </div>
</div>

<noscript>
  <style is:inline>
    .track { height: auto !important; }
    .stage { position: static !important; height: auto !important; overflow: visible !important; }
    .world { position: static !important; transform: none !important; }
    .layer { position: static !important; width: auto !important; height: auto !important; padding: 4rem 1.5rem; }
    [data-edges], .snap { display: none; }
    .neuron { --a: 1 !important; --axon: 1 !important; }
  </style>
</noscript>

<script>
  import { mountForward } from '../lib/forward';
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (track) mountForward(track);
</script>
