---
import { nodes, skills, type Node } from '../data/profile';
import SectionHead from './SectionHead.astro';

const groups: { kind: Node['kind']; label: string; id?: string }[] = [
  { kind: 'role', label: 'roles' },
  { kind: 'project', label: 'projects', id: 'projects' },
];
---

<section id="work" class="mx-auto max-w-6xl scroll-mt-8 px-6 py-28 md:px-10 md:py-36">
  <SectionHead label="work" />
  <p class="label mt-3 max-w-sm normal-case">hover a skill or a node — activation flows across the layer</p>

  <div data-graph class="graph relative mt-14 grid gap-12 md:grid-cols-[11rem_1fr] md:gap-32">
    <svg data-edges class="pointer-events-none absolute inset-0 hidden h-full w-full md:block" aria-hidden="true"></svg>

    <ul class="flex flex-wrap gap-x-4 gap-y-2 md:flex-col md:items-end md:justify-center md:gap-y-2.5" aria-label="Skills">
      {
        skills.map((s) => (
          <li>
            <button
              type="button"
              data-skill={s.id}
              class="flex cursor-default items-center gap-2.5 font-mono text-xs text-paper/45 transition-colors duration-200 data-on:text-paper"
            >
              {s.label}
              <span data-dot class="dot size-[5px] rounded-full border border-signal-hi transition-colors" />
            </button>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col gap-12">
      {
        groups.map((g) => (
          <div id={g.id} class="scroll-mt-24">
            <p class="label mb-4">{g.label}</p>
            <ol class="flex flex-col">
              {nodes
                .filter((n) => n.kind === g.kind)
                .map((n) => (
                  <li data-node={n.id} data-uses={n.uses.join(' ')} class="node border-t border-paper/[0.07] transition-opacity duration-300">
                    <button
                      type="button"
                      data-toggle
                      aria-expanded="false"
                      aria-controls={`d-${n.id}`}
                      class="grid w-full cursor-pointer grid-cols-[auto_1fr_auto] items-center gap-4 py-4 text-left"
                    >
                      <span data-dot class="dot size-[7px] rounded-full border border-signal-hi transition-colors" />
                      <span class="flex flex-wrap items-baseline gap-x-3">
                        <span class="text-lg">{n.org === 'Project' ? n.title : n.org}</span>
                        <span class="font-mono text-xs text-paper/45">
                          {n.org === 'Project' ? '' : n.title}
                        </span>
                      </span>
                      <span class="text-right font-mono text-sm tabular-nums">
                        {n.metric ? (
                          <>
                            <span class="text-signal-hi">{n.metric.value}</span>
                            <span class="ml-2 hidden text-xs text-paper/40 sm:inline">{n.metric.label}</span>
                          </>
                        ) : (
                          <span class="text-xs text-paper/40">{n.when}</span>
                        )}
                      </span>
                    </button>
                    <div id={`d-${n.id}`} class="detail grid">
                      <div class="overflow-hidden">
                        <p class="max-w-xl pb-5 pl-[calc(7px+1rem)] text-sm leading-relaxed text-paper/60">
                          {n.line} <span class="ml-1 font-mono text-xs text-paper/35">{n.when}</span>
                        </p>
                      </div>
                    </div>
                  </li>
                ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .graph :global(svg path) {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 0.75;
    opacity: 0.45;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1.4s cubic-bezier(0.3, 0, 0.2, 1) var(--d, 0ms),
      opacity 250ms ease,
      stroke 250ms ease;
  }
  .graph[data-seen] :global(svg path) {
    stroke-dashoffset: 0;
  }
  .graph[data-focus] :global(svg path) {
    opacity: 0.08;
  }
  .graph[data-focus] :global(svg path[data-on]) {
    opacity: 1;
    stroke: var(--color-signal-hi);
    stroke-width: 1;
  }
  .graph[data-focus] .node:not([data-on]) {
    opacity: 0.35;
  }
  [data-on] > .dot,
  [data-on] > button > .dot {
    background: var(--color-signal-hi);
  }
  .detail {
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms ease;
  }
  [data-open] .detail {
    grid-template-rows: 1fr;
  }
  @media (prefers-reduced-motion: reduce) {
    .graph :global(svg path) {
      stroke-dashoffset: 0;
      transition: none;
    }
    .detail {
      transition: none;
    }
  }
</style>

<script>
  import { mountGraph } from '../lib/nn/graph';
  const root = document.querySelector<HTMLElement>('[data-graph]');
  if (root) mountGraph(root);
</script>
