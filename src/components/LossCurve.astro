---
// A training-loss chart for the output layer: each career milestone is a
// checkpoint, and a noisy "raw" run is drawn between them. Hover, focus or tap
// a checkpoint for its story. Content lives in src/data/milestones.ts.
import { milestones } from '../data/milestones';

const START = 1; // loss at initialisation, before the first checkpoint
const W = 260;
const H = 96;
const PAD = { l: 1, r: 8, t: 8, b: 1 };
const loss = [START, ...milestones.map((m) => m.loss)];
const N = loss.length - 1;
const X = (e: number) => PAD.l + (e / N) * (W - PAD.l - PAD.r);
const Y = (v: number) => PAD.t + (1 - v / START) * (H - PAD.t - PAD.b);

// Smoothed curve: monotone cubic (Fritsch–Carlson) through the checkpoints in
// log space, so it only ever goes down and decays like a real run.
const lg = loss.map(Math.log);
const d = lg.slice(1).map((v, i) => v - lg[i]);
const m = lg.map((_, i) => (i === 0 ? d[0] : i === N ? d[N - 1] : 2 / (1 / d[i - 1] + 1 / d[i])));
function smooth(e: number) {
  const i = Math.min(Math.floor(e), N - 1);
  const t = e - i;
  const t2 = t * t;
  const t3 = t2 * t;
  return Math.exp((2 * t3 - 3 * t2 + 1) * lg[i] + (t3 - 2 * t2 + t) * m[i] + (-2 * t3 + 3 * t2) * lg[i + 1] + (t3 - t2) * m[i + 1]);
}

// Raw curve: the smoothed one plus seeded, slightly correlated noise and the
// odd spike. Same seed, same curve on every build.
const STEPS = 36; // samples per epoch
let seed = 11;
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let r = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
  return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
};
let wander = 0;
const raw: string[] = [];
const fit: string[] = [];
for (let k = 0; k <= N * STEPS; k++) {
  const e = k / STEPS;
  const base = smooth(e);
  wander = wander * 0.55 + (rand() + rand() - 1) * 0.45;
  const spike = rand() < 0.02 ? rand() * 0.35 : 0;
  const v = Math.min(START * 1.04, base * Math.exp(wander * 0.4 + spike));
  raw.push(`${X(e).toFixed(1)},${Y(v).toFixed(1)}`);
  fit.push(`${X(e).toFixed(1)},${Y(base).toFixed(1)}`);
}
const rawPath = `M${raw.join('L')}`;
const fitPath = `M${fit.join('L')}`;

const points = milestones.map((ms, i) => ({ ...ms, epoch: i + 1, x: X(i + 1), y: Y(ms.loss) }));
const fmt = (v: number) => v.toFixed(2);
---

<figure data-loss class="loss" aria-labelledby="loss-cap">
  <figcaption id="loss-cap" class="sr-only">Training loss over my career: each checkpoint is a milestone, and loss goes down over time.</figcaption>

  <div data-card class="card" aria-hidden="true">
    <p class="label"><span data-card-meta></span></p>
    <p data-card-title class="mt-1.5 text-sm leading-tight text-paper"></p>
    <p data-card-story class="mt-1 text-[12px] leading-snug text-paper/65"></p>
  </div>

  <div class="flex items-baseline justify-between" aria-hidden="true">
    <span class="label">loss</span>
    <span data-readout class="font-mono text-[11px] text-signal-hi tabular-nums">{fmt(loss[N])}</span>
  </div>

  <div class="plot relative mt-2" style={`width: ${W}px; height: ${H}px`}>
    <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} class="block overflow-visible" aria-hidden="true">
      <path d={`M0.5,0V${H - 0.5}H${W}`} class="axis" />
      <path d={rawPath} pathLength="1" class="raw" />
      <path d={fitPath} pathLength="1" class="fit" />
      <line data-guide x1="0" y1="0" x2="0" y2={H} class="guide" />
      {points.map((p, i) => <circle cx={p.x} cy={p.y} r="2.5" class="ckpt" data-ckpt={i} style={`--k: ${i}`} />)}
    </svg>
    {
      points.map((p, i) => (
        <button
          type="button"
          data-pt={i}
          class="hit"
          style={`left: ${p.x}px; top: ${p.y}px`}
          aria-label={`Epoch ${p.epoch}, ${p.when}: ${p.label}. Loss ${fmt(p.loss)}.`}
          aria-describedby={`loss-story-${i}`}
          data-meta={`epoch ${p.epoch} · ${p.when}`}
          data-title={p.label}
          data-story={p.story}
          data-loss-value={fmt(p.loss)}
        />
      ))
    }
    {
      points.map((p, i) => (
        <p id={`loss-story-${i}`} hidden>
          {p.story}
        </p>
      ))
    }
  </div>

  <div class="mt-1.5 flex justify-end" aria-hidden="true">
    <span class="label">epoch</span>
  </div>
</figure>

<noscript>
  <style is:inline>
    .loss { position: static !important; margin-top: 2rem; }
  </style>
</noscript>

<style>
  /* Text-like: fades with its layer and hides once the layer is away. */
  .loss {
    position: relative;
    flex: none;
    align-self: flex-end;
    width: 260px;
    opacity: var(--vis, 1);
  }
  :global(.layer[data-away]) .loss {
    visibility: hidden;
  }
  /* Wide screens: the bottom-right corner of the viewport, which is where the
     output layer's box sits when it's in view. */
  @media (min-width: 1240px) {
    .loss {
      position: absolute;
      bottom: 2.5rem;
      right: calc((100% - 100vw) / 2 + 2.5rem);
    }
  }

  .axis {
    fill: none;
    stroke: color-mix(in oklab, var(--color-paper) 14%, transparent);
    stroke-width: 1;
  }
  .raw,
  .fit {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .raw {
    stroke: color-mix(in oklab, var(--color-paper) 26%, transparent);
    stroke-width: 0.75;
  }
  .fit {
    stroke: var(--color-signal-hi);
    stroke-width: 1.25;
  }
  .guide {
    stroke: color-mix(in oklab, var(--color-signal-hi) 45%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    transition: opacity 150ms;
  }
  .loss[data-active] .guide {
    opacity: 1;
  }
  .ckpt {
    fill: var(--color-ink);
    stroke: var(--color-signal-hi);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 200ms,
      fill 200ms;
  }
  .ckpt[data-on] {
    fill: var(--color-signal-hi);
    transform: scale(1.5);
  }

  /* Invisible hit targets over each checkpoint. */
  .hit {
    position: absolute;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 9999px;
    cursor: pointer;
  }
  .hit:focus-visible {
    outline-offset: -6px;
  }

  .card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 0.75rem);
    padding: 0.7rem 0.8rem 0.75rem;
    background: var(--color-ink);
    border: 1px solid color-mix(in oklab, var(--color-paper) 12%, transparent);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 180ms,
      transform 180ms;
    pointer-events: none;
  }
  .loss[data-active] .card {
    opacity: 1;
    transform: none;
  }

  /* Draw-in when the output layer arrives: the run traces out, then the
     checkpoints land one by one. Only with JS; otherwise it's just drawn. */
  .loss[data-draw] .fit,
  .loss[data-draw] .raw {
    stroke-dasharray: 1;
    animation: draw 1.5s linear 0.15s backwards;
  }
  .loss[data-draw] .ckpt {
    animation: land 400ms ease-out backwards;
    /* Roughly when the curve reaches each one. */
    animation-delay: calc(0.05s + (var(--k) + 1) * 0.3s);
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes land {
    from {
      opacity: 0;
      transform: scale(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loss[data-draw] :is(.fit, .raw, .ckpt) {
      animation: none;
    }
    .card,
    .ckpt,
    .guide {
      transition: none;
    }
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-loss]')) {
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const pts = [...fig.querySelectorAll<HTMLButtonElement>('[data-pt]')];
    const ckpts = [...fig.querySelectorAll<SVGCircleElement>('[data-ckpt]')];
    const guide = $<SVGLineElement>('[data-guide]');
    const readout = $<HTMLElement>('[data-readout]');
    const meta = $<HTMLElement>('[data-card-meta]');
    const title = $<HTMLElement>('[data-card-title]');
    const story = $<HTMLElement>('[data-card-story]');
    const final = readout.textContent;
    let active: number | null = null;

    function show(i: number | null) {
      if (i === active) return;
      active = i;
      fig.toggleAttribute('data-active', i !== null);
      ckpts.forEach((c, k) => c.toggleAttribute('data-on', k === i));
      if (i === null) {
        readout.textContent = final;
        return;
      }
      const b = pts[i];
      const x = ckpts[i].getAttribute('cx')!;
      guide.setAttribute('x1', x);
      guide.setAttribute('x2', x);
      guide.setAttribute('y1', ckpts[i].getAttribute('cy')!);
      readout.textContent = b.dataset.lossValue!;
      meta.textContent = b.dataset.meta!;
      title.textContent = b.dataset.title!;
      story.textContent = b.dataset.story!;
    }

    // Mouse hovers, keyboard focuses, touch taps (a tap toggles, and sticks
    // until the next tap anywhere).
    let tapped = 0;
    pts.forEach((b, i) => {
      b.addEventListener('pointerenter', (e) => e.pointerType !== 'touch' && show(i));
      b.addEventListener('pointerleave', (e) => e.pointerType !== 'touch' && active === i && show(null));
      b.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'touch') return;
        tapped = e.timeStamp;
        show(active === i ? null : i);
      });
      b.addEventListener('focus', (e) => e.timeStamp - tapped > 600 && show(i));
      b.addEventListener('blur', () => active === i && show(null));
    });
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target as Element).closest('[data-pt]')) show(null);
    });
    fig.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') show(null);
    });

    // Replay the draw-in each time the output layer comes into view
    // (forward.ts marks layers out of view with data-away).
    const layer = fig.closest<HTMLElement>('.layer');
    const draw = () => {
      fig.removeAttribute('data-draw');
      void fig.offsetWidth; // restart the animation
      fig.setAttribute('data-draw', '');
    };
    if (layer) {
      let away = layer.hasAttribute('data-away');
      new MutationObserver(() => {
        const now = layer.hasAttribute('data-away');
        if (away && !now) draw();
        away = now;
      }).observe(layer, { attributes: true, attributeFilter: ['data-away'] });
    }
  }
</script>
