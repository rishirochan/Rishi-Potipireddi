---
import { profile } from '../data/profile';
import Glyph from './Glyph.astro';

// Order matters: index = output neuron = spiral arm.
const sections = ['about', 'work', 'projects', 'contact'];
---

<section id="top" data-hero-root class="relative h-svh min-h-[600px] cursor-crosshair overflow-hidden select-none">
  <canvas data-hero class="absolute inset-0" aria-hidden="true"></canvas>

  <div class="relative mx-auto flex h-full max-w-6xl flex-col px-6 md:px-10">
    <header class="flex items-center justify-between pt-6">
      <span class="label text-paper!">rp</span>
      <p class="label tabular-nums">
        epoch <span data-epoch>000</span>
        <span class="mx-1.5 text-signal-hi">·</span>
        loss <span data-loss class="text-paper/80">1.386</span>
        <button data-reinit class="ml-3 cursor-pointer underline decoration-signal underline-offset-4 hover:text-paper">
          reinit
        </button>
      </p>
    </header>

    <div class="flex flex-1 flex-col justify-between gap-10 py-12 md:flex-row md:items-center md:py-0">
      <div data-text class="max-w-md">
        <h1 class="text-5xl leading-[0.95] font-light tracking-tight md:text-7xl">
          Rishi<br />Potipireddi
        </h1>
        <p class="mt-6 text-paper/60">
          {profile.tagline}<span class="mx-2 text-signal-hi">/</span>{profile.school}
        </p>
      </div>

      <nav aria-label="Sections" class="self-end md:self-auto">
        <ol class="flex flex-col gap-3">
          {
            sections.map((s, i) => (
              <li>
                <a
                  href={`#${s}`}
                  data-output
                  style="--p: 0.25"
                  class="group flex items-center gap-4 py-1 font-mono text-sm text-paper/40 transition-colors duration-300 hover:text-paper data-active:text-paper"
                >
                  <Glyph cls={i} />
                  <span class="w-20">{s}</span>
                  <span class="relative h-px w-16 bg-paper/10" aria-hidden="true">
                    <span class="absolute inset-y-0 left-0 w-[calc(var(--p)*100%)] bg-signal-hi" />
                  </span>
                  <span data-prob class="w-8 text-right text-xs text-paper/40 tabular-nums" aria-hidden="true">
                    0.25
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <p class="label pb-6">
      <span class="hidden md:inline">move to run inference · click to perturb weights</span>
      <span class="md:hidden">tap to perturb weights</span>
    </p>
  </div>
</section>

<script>
  import { mountHero } from '../lib/nn/hero';
  const root = document.querySelector<HTMLElement>('[data-hero-root]');
  if (root) mountHero(root);
</script>
